import os
import h5py
import numpy as np
import torch
import matplotlib.pyplot as plt
from pysteps import verification
from datetime import datetime, timedelta

import pytorch_lightning as pl
from torch.utils.data import Dataset, DataLoader
from pytorch_lightning.callbacks import Callback

from ..prediff.imerg.train_imerg_prediff import PreDiffIMERGPLModule

DIAGNOSTICS_ENABLED = True

def extract_geodata():
    return {'projection': {'proj': 'longlat', 'ellps': 'WGS84', 'datum': 'WGS84'}, 'x1': 71.0, 'x2': 83.8, 'y1': 5.0, 'y2': 17.8, 'xpixelsize': 0.1, 'ypixelsize': 0.1, 'cartesian': False, 'zerovalue': 0.0}

def extract_timestamp(fpath):
    with h5py.File(fpath, 'r') as f: return f['time'][()]

def is_sequence_valid(filepaths, interval_minutes=30, tolerance_seconds=300):
    expected_delta = interval_minutes * 60
    for i in range(len(filepaths) - 1):
        try:
            time_diff = int(extract_timestamp(filepaths[i+1])) - int(extract_timestamp(filepaths[i]))
            if abs(time_diff - expected_delta) > tolerance_seconds: return False
        except (IOError, KeyError, TypeError): return False
    return True

def load_sequence(filepaths):
    frames = [h5py.File(fpath, 'r')['precipitationCal'][:] for fpath in filepaths]
    return np.stack(frames)

def inverse_preprocess_data(norm_data, clip_value=100):
    scale_factor = np.log(clip_value + 1)
    original_data = np.exp(norm_data * scale_factor) - 1
    original_data[original_data < 0] = 0.0
    return original_data

class PreDiffPredictionWrapper(pl.LightningModule):
    def __init__(self, prediff_model: PreDiffIMERGPLModule):
        super().__init__()
        self.model = prediff_model
        self.hparams.update(self.model.hparams)
        self.save_hyperparameters(ignore=['prediff_model'])

    def predict_step(self, batch, batch_idx):
        full_seq_tensor, out_filepaths = batch
        with torch.no_grad():
            _, cond = self.model.get_input(full_seq_tensor)
            if 'y' in cond and cond['y'].ndim == 6:
                cond['y'] = cond['y'].squeeze(2)
            y_pred = self.model.sample(cond=cond,
                                       batch_size=full_seq_tensor.size(0),
                                       use_alignment=False)
        return y_pred, out_filepaths

def load_and_wrap_prediff_model(cfg_path, ckpt_path):
    print("Loading original model from config...")
    original_model = PreDiffIMERGPLModule(total_num_steps=1, oc_file=cfg_path)
    print("Loading weights from checkpoint...")
    state_dict = torch.load(ckpt_path, map_location='cpu')
    original_model.torch_nn_module.load_state_dict(state_dict, strict=True)
    original_model.eval()
    print("Creating Lightning wrapper for inference.")
    return PreDiffPredictionWrapper(prediff_model=original_model)

class IMERGPredictionDataset(Dataset):
    def __init__(self, data_dir, forecast_dir, in_len, out_len, interval_minutes):
        self.forecast_dir = forecast_dir
        self.data_dir = data_dir
        self.seq_len = in_len + out_len
        self.interval_minutes = interval_minutes
        self.all_files = sorted([os.path.join(self.data_dir, f) for f in os.listdir(self.data_dir) if f.endswith('.HDF5')])
        self.valid_starts = []
        self.ref_date = datetime(1980, 1, 1)
        
        print("Scanning for valid sequences...")
        for i in range(len(self.all_files) - self.seq_len + 1):
            seq_files = self.all_files[i : i + self.seq_len]
            try:
                ts = int(extract_timestamp(seq_files[0]))
                final_datetime = self.ref_date + timedelta(seconds=ts)
                datetime_str = final_datetime.strftime('%Y%m%d%H%M')
                out_path = os.path.join(self.forecast_dir, f"{datetime_str}.npy")
                
                if os.path.exists(out_path):
                    continue
                
                if is_sequence_valid(seq_files, self.interval_minutes):
                    self.valid_starts.append((i, out_path))
            except (IOError, KeyError, TypeError):
                continue
        print(f"Found {len(self.valid_starts)} new sequences to process.")

    def __len__(self):
        return len(self.valid_starts)

    def __getitem__(self, idx):
        start_idx, out_path = self.valid_starts[idx]
        seq_files = self.all_files[start_idx : start_idx + self.seq_len]
        try:
            seq_data = load_sequence(seq_files)
            seq_data[~np.isfinite(seq_data)] = 0.0
            seq_tensor = torch.from_numpy(seq_data).float().unsqueeze(-1)
            return seq_tensor, out_path
        except (IOError, KeyError):
            return None, None

class PredictionWriter(Callback):
    def on_predict_batch_end(self, trainer, pl_module, outputs, batch, batch_idx, dataloader_idx=0):
        if outputs is None: return
        preds, out_paths = outputs
        valid_indices = [i for i, path in enumerate(out_paths) if path is not None]
        if not valid_indices: return
        preds, out_paths = preds[valid_indices], [out_paths[i] for i in valid_indices]

        for i in range(preds.shape[0]):
            pred_numpy = preds[i].cpu().squeeze(1).numpy()
            np.save(out_paths[i], pred_numpy)
            if DIAGNOSTICS_ENABLED: print(f"  > Saved forecast to {os.path.basename(out_paths[i])}")

def generate_and_save_forecasts_lightning(model, data_dir, forecast_dir, in_len, out_len, interval_minutes, batch_size, num_workers, trainer_kwargs):
    print("\n--- PHASE 1: GENERATING AND SAVING FORECASTS ---")
    dataset = IMERGPredictionDataset(data_dir, forecast_dir, in_len, out_len, interval_minutes)
    if not dataset.valid_starts:
        print("No new sequences to process.")
        return
        
    def collate_fn(batch):
        batch = list(filter(lambda x: x[0] is not None, batch))
        return torch.utils.data.dataloader.default_collate(batch) if batch else (None, None)

    dataloader = DataLoader(dataset, batch_size=batch_size, shuffle=False, num_workers=num_workers, pin_memory=True, collate_fn=collate_fn)
    
    trainer = pl.Trainer(callbacks=[PredictionWriter()], **trainer_kwargs)
    print(f"Starting prediction with {trainer.num_devices} device(s), batch size {batch_size}, and {num_workers} workers.")
    trainer.predict(model, dataloaders=dataloader)

def calculate_metrics_and_plot(data_dir, forecast_dir, plot_dir, in_len, out_len, interval_minutes, clip_value, thresholds, scales):
    print("\n--- PHASE 2: CALCULATING METRICS AND PLOTTING ---")
    all_data_files = sorted([os.path.join(data_dir, f) for f in os.listdir(data_dir) if f.endswith('.HDF5')])
    
    datetime_str_to_idx = {}
    for i, f_path in enumerate(all_data_files):
        try:
            ts = int(extract_timestamp(f_path))
            dt_obj = datetime(1970, 1, 1) + timedelta(seconds=ts)
            datetime_str_to_idx[dt_obj.strftime('%Y%m%d%H%M')] = i
        except (IOError, KeyError, TypeError):
            continue
    
    all_forecast_files = sorted([os.path.join(forecast_dir, f) for f in os.listdir(forecast_dir) if f.endswith('.npy')])
    if not all_forecast_files:
        print("No forecast files found. Aborting."); return
        
    csi_verifier, fss_verifier = verification.get_method("CSI"), verification.get_method("FSS")
    all_scores_prediff_fss, all_scores_per_fss = [], []
    all_scores_prediff_csi, all_scores_per_csi = [], []

    for forecast_path in all_forecast_files:
        basename = os.path.basename(forecast_path)
        forecast_dt_str = os.path.splitext(basename)[0]
        if forecast_dt_str not in datetime_str_to_idx:
            continue

        start_of_input_idx = datetime_str_to_idx[forecast_dt_str]
        gt_start_idx = start_of_input_idx + in_len
        gt_end_idx = gt_start_idx + out_len
        if gt_end_idx > len(all_data_files): continue
            
        print(f"Verifying forecast {basename}...")
        prediff_forecast_norm = np.load(forecast_path)
        obs_norm = load_sequence(all_data_files[gt_start_idx:gt_end_idx])
        last_input_frame_norm = load_sequence([all_data_files[start_of_input_idx + in_len - 1]])
        persistence_norm = np.stack([last_input_frame_norm[0]] * out_len)

        prediff_inv = inverse_preprocess_data(prediff_forecast_norm, clip_value)
        persistence_inv = inverse_preprocess_data(persistence_norm, clip_value)
        obs_inv = inverse_preprocess_data(obs_norm, clip_value)
        
        num_thr, num_scl = len(thresholds), len(scales)
        seq_prediff_fss, seq_per_fss = np.zeros((num_thr, num_scl, out_len)), np.zeros((num_thr, num_scl, out_len))
        seq_prediff_csi, seq_per_csi = np.zeros((num_thr, out_len)), np.zeros((num_thr, out_len))
        
        for t, thr in enumerate(thresholds):
            for k in range(out_len):
                current_obs, current_prediff, current_persistence = np.squeeze(obs_inv[k]), np.squeeze(prediff_inv[k]), np.squeeze(persistence_inv[k])
                seq_prediff_csi[t, k] = csi_verifier(current_prediff, current_obs, thr=thr).get('CSI', np.nan)
                seq_per_csi[t, k] = csi_verifier(current_persistence, current_obs, thr=thr).get('CSI', np.nan)
                for s, scale in enumerate(scales):
                    seq_prediff_fss[t, s, k] = fss_verifier(current_prediff, current_obs, thr=thr, scale=scale)
                    seq_per_fss[t, s, k] = fss_verifier(current_persistence, current_obs, thr=thr, scale=scale)

        all_scores_prediff_fss.append(seq_prediff_fss); all_scores_per_fss.append(seq_per_fss)
        all_scores_prediff_csi.append(seq_prediff_csi); all_scores_per_csi.append(seq_per_csi)

    if not all_scores_prediff_fss: print("No scores were calculated."); return

    mean_prediff_fss = np.nanmean(np.stack(all_scores_prediff_fss), axis=0)
    mean_per_fss = np.nanmean(np.stack(all_scores_per_fss), axis=0)
    mean_prediff_csi = np.nanmean(np.stack(all_scores_prediff_csi), axis=0)
    mean_per_csi = np.nanmean(np.stack(all_scores_per_csi), axis=0)
    
    lead_times = np.arange(1, out_len + 1) * interval_minutes
    pixel_size_km = extract_geodata()['xpixelsize'] * 111.0
    
    print("\nGenerating FSS plot for PreDiff model...")
    fig, axes = plt.subplots(nrows=2, ncols=2, figsize=(15, 12), sharex=True, sharey=True)
    axes = axes.flatten()
    fig.suptitle('PreDiff Model: FSS vs. Lead Time', fontsize=20, y=0.96)
    for t, thresh in enumerate(thresholds):
        ax = axes[t]
        for s, scale_val in enumerate(scales):
            ax.plot(lead_times, mean_prediff_fss[t, s, :], marker='o', markersize=4, linestyle='-', label=f"{scale_val * pixel_size_km:.0f} km")
        ax.set_title(f'Threshold: {thresh} mm/hr'); ax.grid(True); ax.legend(); ax.set_ylim(0, 1); ax.set_xticks(lead_times)
    fig.text(0.5, 0.04, 'Lead Time (minutes)', ha='center'); fig.text(0.06, 0.5, 'FSS', ha='center', rotation='vertical')
    plt.tight_layout(rect=[0.08, 0.05, 1, 0.94]); plt.savefig(os.path.join(plot_dir, "prediff_fss_multipanel.png"), dpi=300); plt.close()

    print("Generating comparison plots...")
    for t, thr in enumerate(thresholds):
        for s, scale in enumerate(scales):
            scale_in_km = scale * pixel_size_km
            plt.figure(figsize=(12, 8), dpi=150)
            plt.plot(lead_times, mean_per_fss[t, s, :], label="Persistence FSS", marker='s', color='red')
            plt.plot(lead_times, mean_prediff_fss[t, s, :], label="PreDiff FSS", marker='o', color='blue')
            plt.plot(lead_times, mean_per_csi[t, :], label="Persistence CSI", marker='^', linestyle='--', color='red')
            plt.plot(lead_times, mean_prediff_csi[t, :], label="PreDiff CSI", marker='x', linestyle='--', color='blue')
            plt.title(f"Forecast Skill vs. Lead Time (Threshold: {thr} mm/hr, Scale: {scale_in_km:.0f} km)"); plt.xlabel("Lead Time (minutes)"); plt.ylabel("Score")
            plt.xticks(lead_times); plt.yticks(np.arange(0, 1.1, 0.1)); plt.ylim(0, 1); plt.grid(True); plt.legend(); plt.tight_layout()
            plt.savefig(os.path.join(plot_dir, f"comparison_thr{thr}_scl{scale}.png")); plt.close()
    print(f"All plots saved in '{plot_dir}'.")

def main():
    base_dir = '/home/sac/data_67/Nowcasting/data/required_valid_south'
    cfg_path = 'scripts/prediff/imerg/prediff_imerg_south.yaml'
    ckpt_path = 'models_south/imerg_earthformerunet.pt'
    
    forecast_dir = os.path.abspath('forecasts_prediff_valid_south')
    plot_dir = os.path.abspath('plots_prediff_valid_south')
    os.makedirs(forecast_dir, exist_ok=True)
    os.makedirs(plot_dir, exist_ok=True)
    
    BATCH_SIZE, NUM_WORKERS = 32, 32
    accelerator = 'gpu' if torch.cuda.is_available() else 'cpu'
    precision = '16-mixed' if accelerator == 'gpu' else '32-true' 
    trainer_kwargs = {"accelerator": accelerator, "devices": 'auto', "precision": precision, "logger": False, "enable_progress_bar": True}
    
    model_wrapper = load_and_wrap_prediff_model(cfg_path, ckpt_path)
    
    params = {
        'in_len': model_wrapper.hparams.layout.in_len,
        'out_len': model_wrapper.hparams.layout.out_len,
        'interval_minutes': 30,
        'clip_value': 100,
        'thresholds': [2.5, 7.6, 16.0, 50.0],
        'scales': [1, 2, 4, 8, 16],
    }
    
    generate_and_save_forecasts_lightning(
        model=model_wrapper, 
        data_dir=base_dir, 
        forecast_dir=forecast_dir, 
        in_len=params['in_len'], 
        out_len=params['out_len'], 
        interval_minutes=params['interval_minutes'],
        batch_size=BATCH_SIZE, 
        num_workers=NUM_WORKERS, 
        trainer_kwargs=trainer_kwargs
    )
    
    calculate_metrics_and_plot(
        data_dir=base_dir, 
        forecast_dir=forecast_dir, 
        plot_dir=plot_dir, 
        **params
    )
    
    print("\nProcessing complete.")

if __name__ == '__main__':
    main()
